# Route every relay request to index.php and pass the Authorization header to PHP.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule ^(config|config\.example|k-lani-relay|sweep)\.php$ - [F,L]
RewriteRule ^data(/|$) - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
</IfModule>
Options -Indexes
