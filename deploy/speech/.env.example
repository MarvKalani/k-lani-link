# Use absolute paths on the machine that runs the speech containers.
LINK_SPEECH_SOCKET_DIR=/absolute/private/path/to/speech-sockets
LINK_SPEECH_VOICE_DIR=/absolute/private/path/to/voice
LINK_SPEECH_AUDIO8_MODEL=/absolute/path/to/Audio8-TTS-Realistic-Air
LINK_SPEECH_MING_MODEL=/absolute/path/to/Ming-3.0-tts-0.5B
LINK_SPEECH_MING_SOURCE=/absolute/path/to/Ming-3.0-tts
LINK_SPEECH_NEMOTRON_MODEL=/absolute/path/to/nemotron-3.5-asr-streaming-0.6b.q8_0.gguf
