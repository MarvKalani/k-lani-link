# Use the Compose defaults for the checked source revision, or override both.
# BASALT_SOURCE_CONTEXT=https://github.com/jesdga95/basalt.git#2729e2288f59e01836ddd7fcc630810ada98995a
# BASALT_REVISION=2729e2288f59e01836ddd7fcc630810ada98995a
# BASALT_IMAGE=ghcr.io/marvkalani/k-lani-link-basalt:<image-tag>
BASALT_MODEL_PATH=/absolute/path/to/model.basalt
BASALT_BUILD_JOBS=2
# WebRTC (compose.yaml alone):
LINK_HOST_CONFIG=/absolute/path/to/private/host.toml
# HTTPS relay (with compose.https.yaml) instead:
# LINK_RELAY_URL=https://relay.example.com
# LINK_TOKEN_DIR=/absolute/path/to/private/tokens
