@@ -0,0 +1,160 @@
+"""Privacy admission, streaming parity, diagnostics retention and quiet process startup."""
+from __future__ import annotations
+
+import contextlib
+import http.client
+import io
+import json
+import os
+import socket
+import subprocess
+import tempfile
+import sys
+import time
+import unittest
+import urllib.error
+import urllib.request
+from pathlib import Path
+
+from serve.config import build_parser, parse_settings
+from serve.engine.mock import MockEngine
+from serve.frontend import ChatTemplate
+from serve.handler import serve
+from serve.privacy import NullLogBuffer
+from serve.service import Service
+from serve.util.text import ByteTokenizer
+
+ROOT = Path(__file__).resolve().parents[2]
+HTTP = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+
+
+def request(base, path, body=None):
+    req = urllib.request.Request(base + path, data=json.dumps(body).encode() if body is not None else None,
+                                 headers={"Content-Type": "application/json"})
+    try:
+        with HTTP.open(req, timeout=5) as response:
+            return response.status, response.read()
+    except urllib.error.HTTPError as error:
+        with error:
+            return error.code, error.read()
+
+
+class Privacy(unittest.TestCase):
+    @unittest.skipUnless(hasattr(socket, "AF_UNIX"), "Unix sockets required")
+    def test_unix_socket_preserves_thinking_and_has_no_tcp_listener(self):
+        tok = ByteTokenizer()
+        engine = MockEngine(tok, "checking.</think>\n\nanswer", record_requests=False)
+        svc = Service(engine, tok, ChatTemplate(ROOT / "serve/chat_template.jinja"), privacy=True)
+        with tempfile.TemporaryDirectory() as directory:
+            path = str(Path(directory) / "basalt.sock")
+            httpd = serve(svc, unix_socket=path)
+            try:
+                self.assertEqual(httpd.socket.family, socket.AF_UNIX)
+                client = http.client.HTTPConnection("localhost", timeout=5)
+                client.sock = socket.socket(socket.AF_UNIX)
+                client.sock.connect(path)
+                client.request("POST", "/v1/chat/completions", json.dumps({"model": svc.model,
+                    "messages": [{"role": "user", "content": "hello"}], "stream": True}),
+                    {"Content-Type": "application/json"})
+                with client.getresponse() as response:
+                    raw = response.read()
+                    self.assertEqual(response.status, 200)
+                self.assertIn(b"reasoning_content", raw)
+                self.assertIn(b"[DONE]", raw)
+                self.assertFalse(svc.history)
+            finally:
+                svc.stop(); httpd.shutdown(); httpd.server_close()
+            self.assertFalse(Path(path).exists())
+
+    def test_diagnostic_network_and_image_options_are_rejected(self):
+        for flags in (["--debug"], ["--request-lines"], ["--open"], ["--vision", "cpu"],
+                      ["--host", "0.0.0.0"], ["--cors-origin", "*"], ["--allowed-host", "*"],
+                      ["--draft-log", "out"], ["--dump-routing", "out"],
+                      ["--expert-profile-save", "out"], ["--profile"],
+                      ["--conversation-cache-dir", "out"], ["--conversation-cache-disk-mib", "64"]):
+            with self.subTest(flags=flags), self.assertRaises(ValueError):
+                parse_settings(build_parser(), ["--privacy", *flags])
+        args, _, _, _ = parse_settings(build_parser(), ["--privacy", "--model", "m.basalt", "--kv", "int8"])
+        self.assertTrue(args.privacy)
+
+    def test_answer_room_is_quiet_in_privacy_mode(self):
+        tok = ByteTokenizer()
+        svc = Service(MockEngine(tok, "done", record_requests=False), tok,
+                      ChatTemplate(ROOT / "serve/chat_template.jinja"), privacy=True)
+        output = io.StringIO()
+        with contextlib.redirect_stdout(output), contextlib.redirect_stderr(output):
+            self.assertLess(svc.answer_budget({}, 4096, None), 4096)
+        self.assertEqual(output.getvalue(), "")
+
+    def test_null_logger_never_keeps_messages(self):
+        logs = NullLogBuffer()
+        logs.add("server", "sensitive marker")
+        self.assertEqual(logs.since(), ([], 0))
+        self.assertEqual(vars(logs), {})
+
+    def test_api_streams_without_history_metrics_or_image_downloads(self):
+        tok = ByteTokenizer()
+        engine = MockEngine(tok, "</think>\n\nprivate answer", record_requests=False)
+        svc = Service(engine, tok, ChatTemplate(ROOT / "serve/chat_template.jinja"), privacy=True)
+        httpd = serve(svc, port=0)
+        base = f"http://127.0.0.1:{httpd.server_address[1]}"
+        try:
+            status, body = request(base, "/health")
+            self.assertEqual(status, 200)
+            self.assertEqual(json.loads(body)["link_privacy"]["application_logs"], False)
+            for path in ("/", "/metrics", "/api/logs", "/status", "/slots", "/props", "/web/app.js"):
+                self.assertEqual(request(base, path)[0], 404)
+            self.assertEqual(request(base, "/v1/unload", {})[0], 404)
+            prompt = {"model": svc.model, "messages": [{"role": "user", "content": "private question"}], "stream": True}
+            with contextlib.redirect_stdout(io.StringIO()):
+                status, body = request(base, "/v1/chat/completions", prompt)
+            self.assertEqual(status, 200)
+            events = [json.loads(line[6:]) for line in body.decode().splitlines()
+                      if line.startswith("data: {")]
+            text = "".join(event["choices"][0].get("delta", {}).get("content", "") for event in events)
+            self.assertEqual(text, "private answer")
+            self.assertIn(b"[DONE]", body)
+            self.assertFalse(svc.history)
+            self.assertFalse(svc.slot_last)
+            self.assertFalse(svc.best)
+            self.assertEqual(svc.requests_done, 0)
+            self.assertIsNone(svc.last_timings)
+            self.assertEqual(svc.logs.since(), ([], 0))
+            self.assertFalse(getattr(svc, "telemetry", None))
+            self.assertFalse(engine.requests)
+            self.assertFalse(engine.last_prompt)
+            self.assertNotIn("tail", svc.status)
+            image = {"model": svc.model, "messages": [{"role": "user", "content": [
+                {"type": "image_url", "image_url": {"url": "http://127.0.0.1:1/must-not-fetch"}}]}]}
+            self.assertEqual(request(base, "/v1/chat/completions", image)[0], 400)
+        finally:
+            svc.stop()
+            httpd.shutdown()
+            httpd.server_close()
+
+    def test_private_server_emits_no_stdout_or_stderr(self):
+        with socket.socket() as sock:
+            sock.bind(("127.0.0.1", 0))
+            port = sock.getsockname()[1]
+        proc = subprocess.Popen([sys.executable, "-B", "-m", "serve.server", "--privacy", "--mock-engine",
+                                 "--port", str(port)], cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"})
+        try:
+            deadline = time.monotonic() + 10
+            while True:
+                try:
+                    self.assertEqual(request(f"http://127.0.0.1:{port}", "/health")[0], 200)
+                    break
+                except (OSError, urllib.error.URLError):
+                    if time.monotonic() > deadline or proc.poll() is not None:
+                        self.fail("privacy server did not start")
+                    time.sleep(0.05)
+        finally:
+            proc.terminate()
+            stdout, stderr = proc.communicate(timeout=10)
+        self.assertEqual(stdout, b"")
+        self.assertEqual(stderr, b"")
+
+
+if __name__ == "__main__":
+    unittest.main()
