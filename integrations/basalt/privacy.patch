diff --git a/serve/privacy.py b/serve/privacy.py
new file mode 100644
index 0000000..bec5b39
--- /dev/null
+++ b/serve/privacy.py
@@ -0,0 +1,47 @@
+"""Explicit text-only serving without application logs or diagnostic retention."""
+from __future__ import annotations
+
+import os
+import sys
+
+
+class NullLogBuffer:
+    """The log interface without a buffer, counters or retained messages."""
+
+    def add(self, src: str, text: str) -> None:
+        pass
+
+    def since(self, after_id: int = 0, limit: int = 500) -> tuple[list, int]:
+        return [], 0
+
+
+def silence_stdio() -> None:
+    """Discard Python and native output; inherited child descriptors stay quiet."""
+    sink = os.open(os.devnull, os.O_WRONLY)
+    try:
+        for fd in (1, 2):
+            os.dup2(sink, fd)
+    finally:
+        if sink not in (1, 2):
+            os.close(sink)
+    sys.stdout = open(os.devnull, "w", encoding="utf-8")
+    sys.stderr = open(os.devnull, "w", encoding="utf-8")
+
+
+def validate(args, engine_words: list[str]) -> None:
+    """Reject options that can expose or record request-derived information."""
+    if args.host not in ("127.0.0.1", "::1", "localhost"):
+        raise ValueError("privacy requires a loopback listener")
+    if args.debug or args.request_lines or args.open or args.vision != "off":
+        raise ValueError("privacy forbids debug, request-lines, open and vision")
+    if args.allowed_host or args.cors_origin:
+        raise ValueError("privacy forbids extra browser origins and Host names")
+    if args.unix_socket and not os.path.isabs(args.unix_socket):
+        raise ValueError("unix-socket requires an absolute path")
+    for word in engine_words:
+        name = word.split("=", 1)[0]
+        if name.startswith(("--dump", "--log", "--trace", "--expert-profile-save")) or name in (
+                "--draft-log", "--profile", "--stage-timing", "--vision", "--vision-mmproj"):
+            raise ValueError("privacy forbids engine diagnostics and image input")
+        if name in ("--conversation-cache-dir", "--conversation-cache-disk-mib"):
+            raise ValueError("privacy forbids writing conversations to disk")
