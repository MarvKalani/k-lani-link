new file mode 100644
index 0000000..3714e56
--- /dev/null
+++ b/serve/numeric_metrics.py
@@ -0,0 +1,96 @@
+"""Opt-in counters and timings only. No payloads, token strings, IDs, paths, logs or request history."""
+import json
+import math
+import os
+from pathlib import Path
+import stat
+import tempfile
+import threading
+import time
+
+
+def number(value):
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        return None
+    return value if math.isfinite(value) and value >= 0 else None
+
+
+def completed(timings, ttft, output_tokens):
+    timings = timings if isinstance(timings, dict) else {}
+    return {"finished_at": time.time(), "output_tokens": number(output_tokens),
+            "prefill_tokens": number(timings.get("prompt_n")),
+            "cached_tokens": number(timings.get("cache_n")),
+            "prefill_ms": number(timings.get("prompt_ms")),
+            "prefill_tokens_per_second": number(timings.get("prompt_per_second")),
+            "decode_ms": number(timings.get("predicted_ms")),
+            "decode_tokens_per_second": number(timings.get("predicted_per_second")),
+            "ttft_ms": ttft * 1000 if number(ttft) is not None else None}
+
+
+def snapshot(service):
+    with service.status_lock:
+        live = [dict(st) for st, _ in service.live_reqs.values()] or [dict(service.status)]
+        last = dict(service.performance_last) if service.performance_last else None
+    active = [st for st in live if st.get("busy")]
+    state = "generating" if any(st.get("first_token") is not None for st in active) else \
+            "reading" if active else "idle" if service.loaded() else "unloaded"
+    # Service's rate is computed from generated-token counters, never SSE chunks or characters.
+    from serve.service import RATE_WINDOW_S
+    return {"schema": 1, "observed_at": time.time(), "process_started_at": service.started_at,
+            "backend": "basalt", "model": service.model,
+            "context_tokens_per_slot": service.engine.max_context,
+            "slots": max(1, int(getattr(service.engine, "batch", 0) or 0)),
+            "state": state, "active_requests": len(active),
+            "generated_tokens": sum(number(st.get("generated")) or 0 for st in active),
+            "decode_window_seconds": RATE_WINDOW_S,
+            "live_decode_tokens_per_second": number(service._tok_s()) if state == "generating" else None,
+            "live_prefill_tokens_per_second": number(service._prefill_tok_s_mean()) if state == "reading" else None,
+            "last": last}
+
+
+class NumericMetrics:
+    def __init__(self, service, path: Path):
+        if not service.privacy or not path.is_absolute():
+            raise ValueError("numeric metrics require privacy mode and an absolute path")
+        self.service, self.path = service, path
+        if path.exists() or path.is_symlink():
+            info = path.lstat()
+            if not stat.S_ISREG(info.st_mode) or (hasattr(os, "getuid") and info.st_uid != os.getuid()):
+                raise ValueError("metrics destination is not an owned regular file")
+        if not path.parent.is_dir():
+            raise ValueError("metrics parent directory does not exist")
+        self.done = threading.Event()
+        self.thread = None
+
+    def write(self):
+        temporary = None
+        try:
+            with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=self.path.parent,
+                                             prefix=".performance-", delete=False) as output:
+                temporary = Path(output.name)
+                json.dump(snapshot(self.service), output, separators=(",", ":"), allow_nan=False)
+            temporary.replace(self.path)
+        finally:
+            if temporary is not None:
+                temporary.unlink(missing_ok=True)
+
+    def start(self):
+        self.service.numeric_metrics = True
+        self.write()
+        def run():
+            while not self.done.wait(0.5):
+                try:
+                    self.write()
+                except (OSError, TypeError, ValueError):
+                    # The collector rejects stale samples. Never log a failed export or disturb inference.
+                    return
+        self.thread = threading.Thread(target=run, daemon=True)
+        self.thread.start()
+
+    def stop(self):
+        self.done.set()
+        if self.thread:
+            self.thread.join(timeout=1)
+        self.service.numeric_metrics = False
+        self.service.performance_last = None
+        self.path.unlink(missing_ok=True)
