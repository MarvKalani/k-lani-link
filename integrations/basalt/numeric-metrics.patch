diff --git a/serve/tests/test_numeric_metrics.py b/serve/tests/test_numeric_metrics.py
new file mode 100644
index 0000000..83614f5
--- /dev/null
+++ b/serve/tests/test_numeric_metrics.py
@@ -0,0 +1,92 @@
+"""Numeric export must not weaken privacy routes or retain inference payloads."""
+import contextlib
+import io
+import json
+from pathlib import Path
+import stat
+import tempfile
+import time
+import unittest
+
+from serve.config import build_parser, parse_settings
+from serve.engine.mock import MockEngine
+from serve.frontend import ChatTemplate, Event
+from serve.handler import serve
+from serve.numeric_metrics import NumericMetrics, completed, snapshot
+from serve.service import Service
+from serve.tests.test_privacy import ROOT, request
+from serve.tests.test_server import ByteTokenizer
+
+
+class NumericPrivacy(unittest.TestCase):
+    def service(self):
+        tok = ByteTokenizer()
+        engine = MockEngine(tok, "checking.</think>\n\nPRIVATE_RESPONSE_MARKER", record_requests=False)
+        return Service(engine, tok, ChatTemplate(ROOT / "serve/chat_template.jinja"), privacy=True)
+
+    def test_whitelist_ignores_arbitrary_payload_fields(self):
+        svc = self.service()
+        svc.status.update(busy=True, first_token=time.time()-2, generated=20, tail="SECRET", tool="SECRET")
+        svc.performance_last = completed({"prompt_n": 10, "prompt_ms": 2, "predicted_per_second": 8,
+                                         "text": "SECRET", "request": "SECRET"}, 0.2, 16)
+        out = snapshot(svc)
+        self.assertNotIn("SECRET", json.dumps(out))
+        self.assertEqual(out["last"]["decode_tokens_per_second"], 8)
+        self.assertEqual(out["last"]["ttft_ms"], 200)
+        self.assertEqual(out["state"], "generating")
+
+    def test_live_numeric_opt_in_keeps_no_response_tail(self):
+        svc = self.service()
+        svc.numeric_metrics = True
+        svc.status.update(busy=True, started=time.time())
+        svc._note(7, [Event("content", "SECRET_RESPONSE")])
+        result = snapshot(svc)
+        self.assertEqual(result["state"], "generating")
+        self.assertEqual(result["generated_tokens"], 7)
+        self.assertGreater(svc.status["first_token"], 0)
+        self.assertTrue(svc.rate)
+        self.assertNotIn("SECRET", repr(svc.status))
+        self.assertNotIn("tail", svc.status)
+
+    def test_opt_in_requires_privacy_and_absolute_path(self):
+        for args in [["--privacy-metrics-file", "/tmp/numeric.json"],
+                     ["--privacy", "--privacy-metrics-file", "relative.json"]]:
+            with self.assertRaises(ValueError):
+                parse_settings(build_parser(), args)
+
+    def test_streaming_has_only_private_numeric_file_and_no_admin_routes(self):
+        svc = self.service()
+        with tempfile.TemporaryDirectory() as directory:
+            file = Path(directory) / "performance.json"
+            metrics = NumericMetrics(svc, file)
+            metrics.start()
+            httpd = serve(svc, port=0)
+            base = f"http://127.0.0.1:{httpd.server_address[1]}"
+            try:
+                with contextlib.redirect_stdout(io.StringIO()):
+                    status, body = request(base, "/v1/chat/completions", {"model": svc.model,
+                        "messages": [{"role": "user", "content": "PRIVATE_PROMPT_MARKER"}], "stream": True})
+                self.assertEqual(status, 200)
+                self.assertIn(b"reasoning_content", body)
+                metrics.write()
+                exported = file.read_text()
+                self.assertNotIn("PRIVATE_", exported)
+                self.assertEqual(stat.S_IMODE(file.stat().st_mode), 0o600)
+                data = json.loads(exported)
+                self.assertEqual(data["state"], "idle")
+                self.assertGreater(data["last"]["output_tokens"], 0)
+                self.assertIsNotNone(data["last"]["ttft_ms"])
+                for path in ("/metrics", "/api/logs", "/status", "/slots", "/props"):
+                    self.assertEqual(request(base, path)[0], 404)
+                self.assertEqual(request(base, "/v1/load", {})[0], 404)
+                self.assertFalse(svc.history)
+                self.assertFalse(svc.slot_last)
+                self.assertIsNone(svc.last_timings)
+                self.assertEqual(svc.logs.since(), ([], 0))
+            finally:
+                metrics.stop(); svc.stop(); httpd.shutdown(); httpd.server_close()
+            self.assertFalse(file.exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
